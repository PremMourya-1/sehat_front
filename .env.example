NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api

# Production frontend domain — used by app/layout.js's metadataBase and
# app/products/[id]/page.js's generateMetadata() to build the absolute
# og:url/og:image URLs link-preview crawlers (WhatsApp, Facebook, etc.)
# require. Falls back to https://www.sehatpotli.in if unset, so this is
# only needed locally to test previews against a non-default domain.
NEXT_PUBLIC_SITE_URL=https://www.sehatpotli.in

# NextAuth v5 (Auth.js)
AUTH_SECRET=change_this_to_a_long_random_string
AUTH_URL=http://localhost:3000

# Must exactly match INTERNAL_API_SECRET in sehat-potli-backend's .env.
INTERNAL_API_SECRET=change_this_to_a_long_random_string

# Google OAuth (https://console.cloud.google.com/apis/credentials) — "Continue
# with Google" login/registration (see src/auth.js). Safe to leave blank: the
# Google provider only registers itself when both are set, so the app boots
# fine without it, just without the Google button doing anything wired up.
# Authorized redirect URI to register in Google Cloud Console:
#   http://localhost:3000/api/auth/callback/google (dev)
#   https://<your-production-domain>/api/auth/callback/google (prod)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
